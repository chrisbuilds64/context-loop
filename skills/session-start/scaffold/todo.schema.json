{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrisbuilds64/context-loop/schema/todo-1.json",
  "title": "Work list",
  "description": "One work list: metadata, value lists, items. The value lists live in the file and can be extended at any time; an item refers to them by id. A new attribute is defined here before it may appear in the file — which is why extra fields are refused everywhere.",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "lov",
    "todos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "updated",
        "defaultAssignee"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "defaultAssignee": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lov": {
      "description": "Value lists. Extending means adding an entry here — not changing the schema.",
      "type": "object",
      "required": [
        "clusters",
        "statuses",
        "priorities",
        "people",
        "sourceKinds"
      ],
      "additionalProperties": false,
      "properties": {
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cluster"
          }
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/status"
          }
        },
        "priorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/priority"
          }
        },
        "people": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "sourceKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/labelled"
          }
        }
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/todo"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{2,4}$"
    },
    "labelled": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "label",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "terminal": {
          "type": "boolean",
          "description": "A final state — the item is done or dropped."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "priority": {
      "type": "object",
      "required": [
        "id",
        "label",
        "rank"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "description": "Higher is more important."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "group",
            "external"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "description": "Where the item came from. kind refers to lov.sourceKinds, ref is a file name or identifier without a path.",
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/slug"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "todo": {
      "type": "object",
      "required": [
        "id",
        "title",
        "cluster",
        "status",
        "priority",
        "assignee",
        "created",
        "updated"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ref"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "description": "Optional long text. The title stays one line."
        },
        "cluster": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "$ref": "#/$defs/slug"
        },
        "priority": {
          "$ref": "#/$defs/slug"
        },
        "assignee": {
          "$ref": "#/$defs/slug"
        },
        "due": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "closed": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdIsEstimate": {
          "type": "boolean",
          "description": "true when the date was inferred rather than recorded."
        },
        "blockedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "withPeople": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true,
          "description": "Further people involved — assignee stays the one person responsible."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        }
      }
    },
    "cluster": {
      "type": "object",
      "required": [
        "id",
        "label",
        "order",
        "prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}$",
          "description": "Short code used when numbering new items in this cluster."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
